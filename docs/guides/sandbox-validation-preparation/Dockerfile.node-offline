# Preparation template only; supply an already present, digest-pinned Node/npm base.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
WORKDIR /opt/reviewed-node-workspace
COPY package.json package-lock.json ./
COPY npm-cache/ /opt/reviewed-npm-cache/
RUN --network=none npm ci --offline --ignore-scripts --no-audit --no-fund \
    --cache /opt/reviewed-npm-cache \
    && npm ls --all --json > /opt/node-dependencies.freeze.json \
    && ln -s /opt/reviewed-node-workspace/node_modules /node_modules
WORKDIR /work
