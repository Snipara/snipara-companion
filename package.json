{
  "name": "snipara-companion",
  "version": "1.4.15",
  "description": "Snipara Git-style companion CLI for local workflow continuity, hooks, hosted context, and Mini Snipara OSS workflows",
  "main": "dist/index.js",
  "bin": {
    "snipara-companion": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs --dts",
    "dev": "tsup src/index.ts --format cjs --watch",
    "prepack": "pnpm build",
    "pretest": "pnpm build",
    "test": "node --test test/*.test.js",
    "pack:smoke": "pnpm build && npm pack --dry-run --json && node dist/index.js --help",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "packageManager": "pnpm@10.28.0",
  "keywords": [
    "snipara",
    "snipara-companion",
    "agent-continuity",
    "agent-workflows",
    "ai-coding-agents",
    "context",
    "project-intelligence",
    "workflow-continuity",
    "llm",
    "claude",
    "cursor",
    "windsurf",
    "codex",
    "gemini",
    "mistral",
    "vscode",
    "continue",
    "automation",
    "hooks",
    "mcp"
  ],
  "author": "Snipara",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Snipara/snipara-companion.git"
  },
  "bugs": {
    "url": "https://github.com/Snipara/snipara-companion/issues"
  },
  "homepage": "https://github.com/Snipara/snipara-companion#readme",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "conf": "^12.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/node": "^20.19.31",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^9.39.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ]
}
